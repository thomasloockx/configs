# Rayscaper development environment

alias vim="nvim"

# Rayscaper project shortcuts
alias cdrsdev="cd ~/dev/Rayscaper"
alias cdrsappdata="cd \$APPDATA/Rayscaper/"

# SketchUp installation directories
alias cdsu26="cd \"C:/Program Files/SketchUp/SketchUp 2026\""
alias cdsu25="cd \"C:/Program Files/SketchUp/SketchUp 2025\""
alias cdsu24="cd \"C:/Program Files/SketchUp/SketchUp 2024\""
alias cdsu23="cd \"C:/Program Files/SketchUp/SketchUp 2023\""
alias cdsu22="cd \"C:/Program Files/SketchUp/SketchUp 2022\""

# SketchUp plugin directories
alias cdsu26plugin="cd \"\$APPDATA/SketchUp/SketchUp 2026/SketchUp/Plugins\""
alias cdsu25plugin="cd \"\$APPDATA/SketchUp/SketchUp 2025/SketchUp/Plugins\""
